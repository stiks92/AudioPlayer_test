# Xcode — user-specific state
xcuserdata/
*.xcuserstate
*.xcscmblueprint
*.xccheckout

# Build products
build/
DerivedData/
*.ipa
*.dSYM.zip
*.dSYM

# Swift Package Manager
.build/
.swiftpm/
Packages/
# Package.resolved is deliberately tracked: an app pins its dependency
# versions so every checkout builds the same product.

# macOS
.DS_Store

# Never commit audio assets: the app ships no bundled catalogue by design —
# users import their own files. Keeps the repo small and rights-clean.
*.mp3
*.m4a
*.flac
*.wav
*.aac
.claude/settings.local.json

# Review-capture sleeves. Fetched, not committed: they are 8 MB of paintings
# that `scripts/fetch_demo_art.sh` rebuilds in one command.
.demo-art/
